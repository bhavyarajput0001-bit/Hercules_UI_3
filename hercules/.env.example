# ─────────────────────────────────────────────────────────────────────────────
# HERCULES front-end runtime configuration
# Copy to `.env.local` (git-ignored) and adjust.
#
# SECURITY RULE: only ever put PUBLIC, non-secret values here.
# API keys, tokens, OAuth secrets and credentials must NEVER exist in this
# project — they live in the Hercules backend / OS keychain / secret manager.
# The front-end authenticates to the backend with a short-lived session that
# the backend issues after its own auth flow (see docs/BACKEND_INTEGRATION.md).
# ─────────────────────────────────────────────────────────────────────────────

# Which transport the service layer uses: `mock` | `http` | `ws` | `ipc`
# `mock`   -> in-browser demo services (default, zero backend required)
# `http`   -> REST + SSE against VITE_HERCULES_API_BASE
# `ws`     -> persistent WebSocket control channel (REST still used for uploads)
# `ipc`    -> Tauri / Electron main-process bridge (desktop shells)
VITE_HERCULES_TRANSPORT=mock

# Base URL of the real Hercules core API (used by http/ws/ipc transports).
# Leave empty while VITE_HERCULES_TRANSPORT=mock.
VITE_HERCULES_API_BASE=
VITE_HERCULES_WS_URL=

# Optional: label shown in the shell so you can tell environments apart.
VITE_HERCULES_ENV_LABEL=LOCAL

# Desktop shell identity (used when packaged for macOS / Windows).
VITE_HERCULES_APP_ID=com.hercules.os

# Telemetry / crash reporting endpoint (leave empty to disable entirely).
VITE_HERCULES_DIAGNOSTICS_ENDPOINT=

# Backend-only configuration. Put this in backend/.env or the shell environment,
# never in .env.local or frontend code.
# NVIDIA_API_KEY=
# HERCULES_FRONTEND_ORIGIN=http://localhost:5173
