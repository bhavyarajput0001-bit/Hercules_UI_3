# Hercules Core Configuration
APP_NAME=Hercules Core
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8420

# OmniRoute Integration
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=dev-key

# Database
DATABASE_URL=sqlite+aiosqlite:///./hercules.db

# Auth
JWT_SECRET=hercules-dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Allow Hercules Frontend (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage
STORAGE_PATH=./storage